# Marketing module — defaults to the SAME database as commerce (config/config.json).
# Only set MARKETING_DB_* if you need to override host/user/db name.

# Optional overrides (omit to use commerce DB: e.g. livecoffee in development)
# MARKETING_DB_NAME=livecoffee
# MARKETING_DB_HOST=127.0.0.1
# MARKETING_DB_PORT=3306
# MARKETING_DB_USER=root
# MARKETING_DB_PASSWORD=

MARKETING_JWT_SECRET=change-me-marketing-jwt-secret
MARKETING_JWT_EXPIRES_IN=7d

MARKETING_ADMIN_EMAIL=admin@busybean.com
MARKETING_ADMIN_PASSWORD=change-me
MARKETING_ADMIN_NAME=Marketing Admin

# Public URLs — one job each (see marketing/utils/publicUrls.js and
# page-builder-nextjs/docs/landing-pages/ENVIRONMENT.md for the full matrix).
# Customer website origin: live /lp/{slug} links (publishedUrl), canonical, sitemap, and the
# Stripe Checkout success/cancel return URLs (controllers/stripe.js; defaults to prod if unset).
#   staging: https://www.stageweb.busybeancoffee.com   prod: https://www.busybeancoffee.com
WEBSITE_PUBLIC_URL=http://localhost:3001
# Campaign Builder app origin: token preview links (/preview/landing-page/...).
CAMPAIGN_APP_URL=http://localhost:3000
# This API's public origin, WITHOUT /api: lead-submit endpoint + uploaded media URLs.
#   staging: https://testingbb.trimworldwide.com   prod: https://backendbb.trimworldwide.com
API_PUBLIC_URL=http://localhost:8013
# Optional: full lead-submit URL override (defaults to API_PUBLIC_URL/api/public/lead-submissions).
# DEFAULT_LEAD_SUBMIT_URL=
# Deprecated: PUBLIC_SITE_URL is only used as a fallback for the three keys above.
# PUBLIC_SITE_URL=
# Optional CDN for uploaded media (takes precedence over API_PUBLIC_URL for media URLs).
CDN_BASE_URL=

# On-demand website refresh after publish/unpublish/archive/delete (see
# services/websiteRevalidate.service.js). Must equal the website's REVALIDATE_SECRET.
# URL defaults to WEBSITE_PUBLIC_URL/api/revalidate.
WEBSITE_REVALIDATE_SECRET=
# WEBSITE_REVALIDATE_URL=http://localhost:3001/api/revalidate

# CORS inventory (log-only for now, see middlewares/corsOriginAudit.js): browser origins
# expected to call the API. Unlisted origins are logged once, never blocked (yet).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# CORS_ENFORCE=true only lets the listed origins call the API from a browser (see
# docs/security/HARDENING.md). Leave unset until the audit log shows no missing origins.
# CORS_ENFORCE=true

# Error responses: stack traces / raw errors only when API_ERROR_DETAILS=true (developer
# machines only — never on a shared server).
# API_ERROR_DETAILS=true

# Lead submissions: store the visitor IP as "anonymized" (default, /24), "full" or "off".
# MARKETING_LEAD_IP_MODE=anonymized

LEAD_NOTIFICATION_FROM=noreply@busybean.com
LEAD_NOTIFICATION_TO=leads@busybean.com

MARKETING_SCHEDULER_ENABLED=true
MARKETING_SCHEDULER_INTERVAL_MS=60000
# Reporting days (analytics dashboard, daily page stats). IANA name. Changing it rebuilds
# rollups on next read; run `npm run marketing:rollup-page-stats` after changing.
MARKETING_REPORT_TIMEZONE=America/New_York
MARKETING_LEAD_RATE_LIMIT_MAX=20
MARKETING_TRACKING_RATE_LIMIT_MAX=300
# Cookie consent log (proof of consent): requests per minute per IP, and how long records are kept
# (days, minimum 30; purged hourly by the scheduler).
# MARKETING_CONSENT_RATE_LIMIT_MAX=30
# MARKETING_CONSENT_LOG_RETENTION_DAYS=1095
# Customer details in Campaign Builder analytics (names, emails, customer journeys): Super Admins
# always; other roles only when listed here (comma-separated, e.g. "Sales,Marketing Manager").
# Every access is logged; the log is kept this many days.
# MARKETING_CUSTOMER_PII_ROLES=
# MARKETING_PII_LOG_RETENTION_DAYS=730
MEDIA_UPLOAD_MAX_BYTES=5242880

# Admin panel → Campaign Builder SSO (see page-builder-nextjs docs/landing-pages/ENVIRONMENT.md).
# Off by default: an admin whose email has no Campaign Builder account is refused.
# MARKETING_SSO_AUTO_CREATE=true
# MARKETING_SSO_DEFAULT_ROLE=Editor

# Scheduled jobs / internal endpoints (docs/API_ACCESS.md): callers send x-job-key with this value.
# Unset = those endpoints still accept unauthenticated calls (warning logged); set it to enforce.
# INTERNAL_JOB_API_KEY=
# Public, price-free product catalog (/api/v1/public/catalog): requests per minute per IP.
# PUBLIC_CATALOG_RATE_LIMIT_MAX=120

# Smoke test (server must be running)
# MARKETING_TEST_BASE_URL=http://127.0.0.1:8013/api
