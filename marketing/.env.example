# Marketing module — defaults to the SAME database as commerce (config/config.json).
# Only set MARKETING_DB_* if you need to override host/user/db name.

# Optional overrides (omit to use commerce DB: e.g. livecoffee in development)
# MARKETING_DB_NAME=livecoffee
# MARKETING_DB_HOST=127.0.0.1
# MARKETING_DB_PORT=3306
# MARKETING_DB_USER=root
# MARKETING_DB_PASSWORD=

MARKETING_JWT_SECRET=change-me-marketing-jwt-secret
MARKETING_JWT_EXPIRES_IN=7d

MARKETING_ADMIN_EMAIL=admin@busybean.com
MARKETING_ADMIN_PASSWORD=change-me
MARKETING_ADMIN_NAME=Marketing Admin

PUBLIC_SITE_URL=http://localhost:5173
CDN_BASE_URL=

LEAD_NOTIFICATION_FROM=noreply@busybean.com
LEAD_NOTIFICATION_TO=leads@busybean.com

MARKETING_SCHEDULER_ENABLED=true
MARKETING_SCHEDULER_INTERVAL_MS=60000
MARKETING_LEAD_RATE_LIMIT_MAX=20
MEDIA_UPLOAD_MAX_BYTES=5242880

# Smoke test (server must be running)
# MARKETING_TEST_BASE_URL=http://127.0.0.1:8011/api
