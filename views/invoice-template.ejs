<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Invoice</title>
  </head>
  <body
    style="
      font-family: Arial, sans-serif;
      color: #000;
      padding: 40px;
      max-width: 800px;
      margin: auto;
    "
  >
    <!-- Header -->
    <div
      style="
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
      "
    >
      <h1 style="font-size: 28px; margin: 0">INVOICE</h1>
      <img
        src="https://admin.busybeancoffee.com/images/logocoffee.png"
        alt="Busy Bean Coffee"
        style="height: 100px "
      />
    </div>

    <!-- Invoice Metadata -->
    <div style="margin-bottom: 30px">
      <p style="margin: 4px 0; font-size: 14px">
        <strong>Invoice number:</strong> <%= order?.invoiceNumber || '' %>
      </p>
      <p style="margin: 4px 0; font-size: 14px">
        <strong>Date of issue:</strong> <%= order?.on || '' %>
      </p>
      <p style="margin: 4px 0; font-size: 14px">
        <strong>PO Number:</strong> <%= order?.poNumber || '' %>
      </p>
    </div>

    <!-- From and Bill To -->
    <div
      style="display: flex; justify-content: space-between; margin-bottom: 30px"
    >
      <div style="width: 45%">
        <% if (order?.salesRep) { %>
        <p
          style="
            margin: 0;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
          "
        >
          Remit To
        </p>
        <p style="margin: 4px 0; font-size: 14px; text-transform: uppercase">
          <%= order.salesRep.srName || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px; text-transform: uppercase">
          <%= order.salesRep.address || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px; text-transform: uppercase">
          <%= order.salesRep.city || '' %>, <%= order.salesRep.state || '' %>
          <%= order.salesRep.zipCode || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px; text-transform: uppercase">
          <%= order.salesRep.country || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px">
          <%= order.salesRep.phoneNumber || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px">
          <%= order.salesRep.email || '' %>
        </p>
        <% } else { %>
        <div>
          <div style="font-size: 14px; font-weight: bold">Remit To</div>
          <div style="font-size: 14px; text-transform: uppercase">
            Busy Bean Coffee Inc.
          </div>
          <div style="font-size: 14px; text-transform: uppercase">
            1141 CAINHOY RD 350
          </div>
          <div style="font-size: 14px; text-transform: uppercase">
            WAREHOUSE 1
          </div>
          <div style="font-size: 14px; text-transform: uppercase">
            CHARLESTON SC 29492, USA
          </div>
          <div style="font-size: 14px; text-transform: uppercase">
            +1 833-843-2326
          </div>
          <div style="font-size: 14px">info@busybeancoffee.com</div>
        </div>
        <% } %>
      </div>

      <div style="width: 45%">
        <p
          style="
            margin: 0;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
          "
        >
          Bill to
        </p>
        <p style="margin: 4px 0; font-size: 14px; text-transform: uppercase">
          <%= order?.user?.name || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px; text-transform: uppercase">
          <%= order?.user?.billingAddresses?.[0]?.addressLineOne || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px; text-transform: uppercase">
          <%= order?.user?.billingAddresses?.[0]?.town || '' %>, <%=
          order?.user?.billingAddresses?.[0]?.state || '' %> <%=
          order?.user?.billingAddresses?.[0]?.zipCode || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px; text-transform: uppercase">
          <%= order?.user?.billingAddresses?.[0]?.country || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px">
          <%= order?.user?.phoneNumber || '' %>
        </p>
        <p style="margin: 4px 0; font-size: 14px">
          <%= order?.user?.email || '' %>
        </p>
      </div>
    </div>

    <!-- Amount Due -->
    <div style="margin-bottom: 30px">
      <p style="font-size: 20px; font-weight: bold; margin: 0">
        $<%= order?.totalBill || '0.00' %> due amount
      </p>
      <a
        href="https://busybeancoffee.com/paymentCheck?orderId=<%=order?.id%>"
        style="color: #1a73e8; font-size: 14px; text-decoration: underline"
      >
        Pay online
      </a>

    </div>

    <!-- Items Table -->
    <table
      style="
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        margin-bottom: 40px;
      "
    >
      <thead>
        <tr style="border-bottom: 2px solid #000">
          <th style="text-align: left; padding: 8px">Code</th>
          <th style="text-align: left; padding: 8px">Item</th>
          <th style="text-align: center; padding: 8px">Quantity</th>
          <th style="text-align: right; padding: 8px">Unit price</th>
          <th style="text-align: right; padding: 8px">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% (order?.items || []).forEach(item => { %>
        <tr>
          <td style="padding: 8px"><%= item?.productCode || '' %></td>
          <td style="padding: 8px; font-weight: 600">
            <%= item?.product || item?.productName %>
          </td>
          <td style="padding: 8px; text-align: center">
            <%= item?.qty || '0' %>
          </td>
          <td style="padding: 8px; text-align: right">
            $<%= ((item?.price / item?.qty) || 0).toFixed(2) %>
          </td>
          <td style="padding: 8px; text-align: right">
            $<%= item?.price || '0.00' %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>

    <!-- Totals -->
    <div style="width: 100%; display: flex; justify-content: flex-end">
      <table style="width: 300px; font-size: 14px">
        <tr>
          <td style="padding: 4px">Subtotal</td>
          <td style="padding: 4px; text-align: right">
            $<%= order?.subTotal || '0.00' %>
          </td>
        </tr>
        <tr>
          <td style="padding: 4px">Shipping Charges</td>
          <td style="padding: 4px; text-align: right">
            $<%= order?.shippingCharges || '0.00' %>
          </td>
        </tr>
        <tr>
          <td style="padding: 4px; font-weight: bold">Total</td>
          <td style="padding: 4px; text-align: right; font-weight: bold">
            $<%= order?.totalBill || '0.00' %>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>
