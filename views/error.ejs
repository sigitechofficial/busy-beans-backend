<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
    <style>
        body { font-family: sans-serif; text-align: center; padding: 50px; }
        h1 { color: #e74c3c; }
        p { color: #333; }
    </style>
</head>
<body>
    <h1>Something went wrong!</h1>
    <p><%= typeof msg !== 'undefined' ? msg : 'An unexpected error occurred.' %></p>
    <a href="/">Go back home</a>
</body>
</html>